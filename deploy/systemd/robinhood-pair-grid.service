[Unit]
Description=Robinhood PAIR single-sided grid keeper
Documentation=https://github.com/MeiYanDong/robinhood-pair-grid
Wants=network-online.target
After=network-online.target
OnFailure=robinhood-pair-grid-alert@%n.service

[Service]
Type=oneshot
User=pair-grid
Group=pair-grid
WorkingDirectory=/opt/robinhood-pair-grid/current
Environment=NODE_ENV=production
Environment=PAIR_GRID_RUN_DIR=/var/lib/robinhood-pair-grid
EnvironmentFile=/etc/robinhood-pair-grid/runtime.env
LoadCredentialEncrypted=pair-grid-private-key:/etc/credstore.encrypted/robinhood-pair-grid-private-key
ExecStart=/usr/local/bin/npm run keeper-once
StateDirectory=robinhood-pair-grid
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/robinhood-pair-grid
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=true
TimeoutStartSec=4min

[Install]
WantedBy=multi-user.target
