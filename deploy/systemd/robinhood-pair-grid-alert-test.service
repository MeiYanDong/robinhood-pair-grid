[Unit]
Description=Send a synthetic non-signing PAIR grid external alert
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pair-grid
Group=pair-grid
WorkingDirectory=/opt/robinhood-pair-grid/current
Environment=NODE_ENV=production
LoadCredentialEncrypted=pair-grid-alert:/etc/credstore.encrypted/pair-grid-alert
ExecStart=/usr/local/bin/node scripts/pair-grid-alert.mjs synthetic-test
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=true
TimeoutStartSec=45s
