[Unit]
Description=Verify the Robinhood PAIR grid systemd credential

[Service]
Type=oneshot
User=pair-grid
Group=pair-grid
WorkingDirectory=/opt/robinhood-pair-grid/current
Environment=PAIR_GRID_RUN_DIR=/var/lib/robinhood-pair-grid
EnvironmentFile=/etc/robinhood-pair-grid/runtime.env
LoadCredentialEncrypted=pair-grid-private-key:/etc/credstore.encrypted/pair-grid-private-key
ExecStart=/usr/local/bin/node scripts/pair-grid.mjs key-check
StateDirectory=robinhood-pair-grid
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/robinhood-pair-grid
CapabilityBoundingSet=
