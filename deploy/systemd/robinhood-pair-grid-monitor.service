[Unit]
Description=Monitor PAIR grid HALTED state and canonical readback
Wants=network-online.target
After=network-online.target
OnFailure=robinhood-pair-grid-alert@%n.service

[Service]
Type=oneshot
User=pair-grid
Group=pair-grid
WorkingDirectory=/opt/robinhood-pair-grid/current
Environment=NODE_ENV=production
Environment=PAIR_GRID_RUN_DIR=/var/lib/robinhood-pair-grid
EnvironmentFile=/etc/robinhood-pair-grid/runtime.env
LoadCredentialEncrypted=pair-grid-alert:/etc/credstore.encrypted/pair-grid-alert
ExecStart=/usr/local/bin/node scripts/pair-grid-alert.mjs monitor-once
StateDirectory=robinhood-pair-grid
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/robinhood-pair-grid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=true
TimeoutStartSec=90s

[Install]
WantedBy=multi-user.target
