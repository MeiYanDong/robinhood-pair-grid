[Unit]
Description=Verify the isolated PAIR/USDG martingale signing credential

[Service]
Type=oneshot
User=pair-grid
Group=pair-grid
WorkingDirectory=/opt/robinhood-pair-grid/current
Environment=PAIR_MARTINGALE_RUN_DIR=/var/lib/robinhood-pair-grid/usdg-martingale-live-1
Environment=PAIR_MARTINGALE_BOOTSTRAP_PATH=/var/lib/robinhood-pair-grid/pair-usdg-martingale-bootstrap.json
EnvironmentFile=/etc/robinhood-pair-grid/runtime.env
LoadCredentialEncrypted=pair-usdg-martingale-private-key:/etc/credstore.encrypted/pair-usdg-martingale-private-key
ExecStart=/usr/local/bin/npm run martingale-key-check
StateDirectory=robinhood-pair-grid
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/robinhood-pair-grid
CapabilityBoundingSet=
