[Unit]
Description=Monitor isolated PAIR/USDG martingale state and keeper heartbeat
Wants=network-online.target
After=network-online.target
OnFailure=robinhood-pair-grid-alert@%n.service

[Service]
Type=oneshot
User=pair-grid
Group=pair-grid
WorkingDirectory=/opt/robinhood-pair-grid/current
Environment=NODE_ENV=production
Environment=PAIR_GRID_MONITOR_MODE=martingale
Environment=PAIR_GRID_RUN_DIR=/var/lib/robinhood-pair-grid/usdg-martingale-live-1
Environment=PAIR_MARTINGALE_RUN_DIR=/var/lib/robinhood-pair-grid/usdg-martingale-live-1
Environment=PAIR_MARTINGALE_BOOTSTRAP_PATH=/var/lib/robinhood-pair-grid/pair-usdg-martingale-bootstrap.json
Environment=PAIR_GRID_KEEPER_HEARTBEAT_PATH=/var/lib/robinhood-pair-grid/usdg-martingale-live-1/keeper-success.heartbeat
Environment=PAIR_GRID_ALERT_HEARTBEAT_MAX_AGE_SECONDS=120
EnvironmentFile=/etc/robinhood-pair-grid/runtime.env
LoadCredentialEncrypted=pair-grid-alert:/etc/credstore.encrypted/pair-grid-alert
ExecStart=/usr/local/bin/node scripts/pair-grid-alert.mjs monitor-once
StateDirectory=robinhood-pair-grid
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/robinhood-pair-grid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=true
TimeoutStartSec=90s

[Install]
WantedBy=multi-user.target
