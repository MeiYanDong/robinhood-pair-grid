[Unit]
Description=Rebase PAIR/USDG martingale buy bands above the configured hard floor
Documentation=https://github.com/MeiYanDong/robinhood-pair-grid
Wants=network-online.target
After=network-online.target
Conflicts=robinhood-pair-usdg-martingale.service
OnFailure=robinhood-pair-grid-alert@%n.service

[Service]
Type=oneshot
User=pair-grid
Group=pair-grid
WorkingDirectory=/opt/robinhood-pair-grid/current
Environment=NODE_ENV=production
Environment=PAIR_MARTINGALE_RUN_DIR=/var/lib/robinhood-pair-grid/usdg-martingale-live-1
Environment=PAIR_MARTINGALE_BOOTSTRAP_PATH=/var/lib/robinhood-pair-grid/pair-usdg-martingale-bootstrap.json
EnvironmentFile=/etc/robinhood-pair-grid/runtime.env
LoadCredentialEncrypted=pair-usdg-martingale-private-key:/etc/credstore.encrypted/pair-usdg-martingale-private-key
ExecStart=/usr/local/bin/npm run martingale-rebase-floor
StateDirectory=robinhood-pair-grid
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/robinhood-pair-grid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=true
TimeoutStartSec=30min
